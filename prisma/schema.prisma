// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BookingType {
  HOURLY
  EVENT
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum BookingStatus {
  HOLD
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum BookingSource {
  WALK_IN
  PHONE
  INSTAGRAM
  REFERRAL
  ONLINE
  CREDITS
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model AppUser {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String?
  role         Role      @default(CUSTOMER)
  notes        String?
  isActive     Boolean   @default(true)
  isPhoneVerified Boolean @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
  payments     Payment[]
  feedback     Feedback[]
  snackOrders  SnackOrder[]
  addedSnackItems SnackOrderItem[]
  createdBookings Booking[] @relation("CreatedBookings")

  // Referral System Fields
  referredById           String?
  referredByPhone        String?
  referredBy             AppUser?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  refereeUsers           AppUser[]  @relation("UserReferrals")
  referralRewardsClaimed Int        @default(0)

  // Prepaid Balance
  creditBalances         UserCreditBalance[]
  prepaidTransactions    PrepaidTransaction[]

  // Streak Challenges
  streakChallenges       StreakChallenge[]   @relation("StreakOwner")
  issuedStreakChallenges StreakChallenge[]   @relation("StreakIssuedBy")

  // Tournaments
  createdTournaments     Tournament[]        @relation("CreatedTournaments")
  tournamentEntries      TournamentParticipant[]

  @@index([phone])
  @@index([role])
  @@map("app_users")
}

model Game {
  id              String    @id @default(cuid())
  name            String
  tag             String    @unique
  description     String?
  basePrice       Decimal   @db.Decimal(10, 2)  // Rs per hour
  minTimeMinutes  Int       @default(30)
  maxTimeMinutes  Int       @default(120)
  deposit         Decimal?  @db.Decimal(10, 2)
  isActive        Boolean   @default(true)
  totalUnits      Int       @default(1)
  hasAccessories  Boolean   @default(false)
  defaultAccessories Int     @default(0)
  maxAccessories   Int       @default(0)
  accessoryPrice   Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  resourceUnits   ResourceUnit[]
  bookings        Booking[]
  creditBalances  UserCreditBalance[] @relation("GameCreditBalances")
  tournaments     Tournament[]

  @@index([tag])
  @@index([isActive])
  @@map("games")
}

model ResourceUnit {
  id        String    @id @default(cuid())
  gameId    String
  unitName  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([gameId])
  @@map("resource_units")
}

model Booking {
  id             String        @id @default(cuid())
  userId         String?
  guestName      String?
  guestPhone     String?
  gameId         String
  resourceUnitId String?
  startDateTime  DateTime
  endDateTime    DateTime
  durationMinutes Int
  accessoriesCount Int         @default(0)
  bookingType    BookingType   @default(HOURLY)
  basePrice      Decimal       @db.Decimal(10, 2)
  discountPct    Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  couponId       String?
  couponDiscount Decimal       @default(0) @db.Decimal(10, 2)
  finalAmount    Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  bookingStatus  BookingStatus @default(HOLD)
  source         BookingSource @default(WALK_IN)
  notes          String?
  holdExpiresAt  DateTime?
  createdById    String?
  negotiatedAmount Decimal?    @db.Decimal(10, 2)
  snacksAmount     Decimal?    @default(0) @db.Decimal(10, 2)
  usedCreditAmount Decimal     @default(0) @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdBy      AppUser?      @relation("CreatedBookings", fields: [createdById], references: [id], onDelete: SetNull)
  game           Game          @relation(fields: [gameId], references: [id])
  resourceUnit   ResourceUnit? @relation(fields: [resourceUnitId], references: [id], onDelete: SetNull)
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  allocations    PaymentAllocation[]
  prepaidTransactions PrepaidTransaction[]

  @@index([startDateTime])
  @@index([gameId])
  @@index([userId])
  @@index([bookingStatus])
  @@index([resourceUnitId])
  @@index([holdExpiresAt])
  @@index([couponId])
  @@map("bookings")
}

model Payment {
  id               String        @id @default(cuid())
  paymentMethod    String
  negotiatedAmount Decimal       @db.Decimal(10, 2)
  cashAmount       Decimal       @db.Decimal(10, 2)
  onlineAmount     Decimal       @db.Decimal(10, 2)
  userId           String?
  customerNames    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  allocations      PaymentAllocation[]
  prepaidTransactions PrepaidTransaction[]
  tournamentParticipants TournamentParticipant[]
  user             AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("payments")
}

model PaymentAllocation {
  id           String      @id @default(cuid())
  amount       Decimal     @db.Decimal(10, 2)
  paymentId    String
  bookingId    String?
  snackOrderId String?
  createdAt    DateTime    @default(now())

  payment      Payment     @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  booking      Booking?    @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  snackOrder   SnackOrder? @relation(fields: [snackOrderId], references: [id], onDelete: SetNull)

  @@index([paymentId])
  @@index([bookingId])
  @@map("payment_allocations")
}

model SnackOrder {
  id            String        @id @default(cuid())
  userId        String?
  guestName     String?
  guestPhone    String?
  amount        Decimal       @db.Decimal(10, 2)
  paymentStatus PaymentStatus @default(UNPAID)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user          AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  allocations   PaymentAllocation[]
  items         SnackOrderItem[]

  @@index([userId])
  @@index([paymentStatus])
  @@map("snack_orders")
}

model SnackOrderItem {
  id           String      @id @default(cuid())
  snackOrderId String
  amount       Decimal     @db.Decimal(10, 2)
  notes        String?     // Optional description of items added
  addedById    String?
  createdAt    DateTime    @default(now())

  snackOrder   SnackOrder  @relation(fields: [snackOrderId], references: [id], onDelete: Cascade)
  addedBy      AppUser?    @relation(fields: [addedById], references: [id], onDelete: SetNull)

  @@index([snackOrderId])
  @@map("snack_order_items")
}

model DiscountRule {
  id              String   @id @default(cuid())
  minHoursInDay   Decimal  @db.Decimal(5, 2)
  discountPct     Decimal  @db.Decimal(5, 2)
  description     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("discount_rules")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("feedback")
}

// ─────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum StreakStatus {
  ACTIVE
  ISSUED
  EXPIRED
}

model Coupon {
  id               String        @id @default(cuid())
  code             String        @unique
  discountType     DiscountType  @default(PERCENTAGE)
  discountValue    Decimal       @db.Decimal(10, 2)
  minBookingAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  allowedRoles     Role[]        @default([ADMIN, STAFF, CUSTOMER])
  isActive         Boolean       @default(true)
  usedCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  bookings         Booking[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model OtpVerification {
  id        String   @id @default(cuid())
  phone     String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("otp_verifications")
}

// ─────────────────────────────────────────
// PREPAID BALANCES & CREDITS
// ─────────────────────────────────────────

model UserCreditBalance {
  id              String   @id @default(cuid())
  userId          String
  balance         Decimal  @db.Decimal(10, 2)
  isAllGames      Boolean  @default(true)
  applicableGames Game[]   @relation("GameCreditBalances")
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            AppUser  @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    PrepaidTransaction[]

  @@index([userId])
  @@index([expiresAt])
  @@map("user_credit_balances")
}

model PrepaidTransaction {
  id              String   @id @default(cuid())
  userId          String
  creditBalanceId String?
  moneyGiven      Decimal  @default(0.00) @db.Decimal(10, 2)
  creditsReceived Decimal  @default(0.00) @db.Decimal(10, 2)
  amount          Decimal  @db.Decimal(10, 2) // positive for adding, negative for deduction
  description     String?
  bookingId       String?
  paymentId       String?
  createdAt       DateTime @default(now())

  user            AppUser            @relation(fields: [userId], references: [id], onDelete: Cascade)
  creditBalance   UserCreditBalance? @relation(fields: [creditBalanceId], references: [id], onDelete: SetNull)
  booking         Booking?           @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment         Payment?           @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([creditBalanceId])
  @@index([createdAt])
  @@map("prepaid_transactions")
}

// ─────────────────────────────────────────
// STREAK CHALLENGE
// ─────────────────────────────────────────

model StreakChallenge {
  id          String       @id @default(cuid())
  userId      String
  startDate   DateTime     // manually chosen by admin/staff
  endDate     DateTime     // startDate + 30 days (stored for queries/display)
  status      StreakStatus @default(ACTIVE)
  issuedAt    DateTime?
  issuedById  String?
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user        AppUser  @relation("StreakOwner", fields: [userId], references: [id], onDelete: Cascade)
  issuedBy    AppUser? @relation("StreakIssuedBy", fields: [issuedById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("streak_challenges")
}

// ─────────────────────────────────────────
// TOURNAMENTS & KNOCKOUT BRACKET SYSTEM
// ─────────────────────────────────────────

enum TournamentStatus {
  DRAFT
  UPCOMING
  REGISTRATION_OPEN
  REGISTRATION_CLOSED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum TournamentFormat {
  SINGLE_ELIMINATION
  DOUBLE_ELIMINATION
  ROUND_ROBIN
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  BYE
  CANCELLED
}

model Tournament {
  id              String           @id @default(cuid())
  title           String
  description     String?          @db.Text
  gameId          String
  startDate       DateTime
  endDate         DateTime?
  entryFee        Decimal          @default(0.00) @db.Decimal(10, 2)
  prizePool       Decimal          @default(0.00) @db.Decimal(10, 2)
  prize1st        String?
  prize2nd        String?
  prize3rd        String?
  maxParticipants Int              @default(16)
  format          TournamentFormat @default(SINGLE_ELIMINATION)
  status          TournamentStatus @default(UPCOMING)
  rules           String?          @db.Text
  bannerUrl       String?
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  game            Game             @relation(fields: [gameId], references: [id])
  createdBy       AppUser?         @relation("CreatedTournaments", fields: [createdById], references: [id], onDelete: SetNull)
  participants    TournamentParticipant[]
  matches         TournamentMatch[]

  @@index([status])
  @@index([gameId])
  @@map("tournaments")
}

model TournamentParticipant {
  id           String      @id @default(cuid())
  tournamentId String
  userId       String?
  playerName   String?
  playerPhone  String?
  playerEmail  String?
  seedNumber   Int?
  paymentId    String?
  isPaid       Boolean     @default(false)
  isCheckedIn  Boolean     @default(false)
  createdAt    DateTime    @default(now())

  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user         AppUser?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  payment      Payment?    @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  matchesAsP1  TournamentMatch[] @relation("MatchPlayer1")
  matchesAsP2  TournamentMatch[] @relation("MatchPlayer2")
  wonMatches   TournamentMatch[] @relation("MatchWinner")

  @@unique([tournamentId, userId])
  @@map("tournament_participants")
}

model TournamentMatch {
  id           String      @id @default(cuid())
  tournamentId String
  roundNumber  Int         // 1 = Round 1, 2 = QF, 3 = SF, 4 = Final
  matchNumber  Int         // Match order in round
  player1Id    String?
  player2Id    String?
  scoreP1      Int         @default(0)
  scoreP2      Int         @default(0)
  winnerId     String?
  nextMatchId  String?
  status       MatchStatus @default(SCHEDULED)
  scheduledAt  DateTime?
  completedAt  DateTime?

  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  player1      TournamentParticipant? @relation("MatchPlayer1", fields: [player1Id], references: [id], onDelete: SetNull)
  player2      TournamentParticipant? @relation("MatchPlayer2", fields: [player2Id], references: [id], onDelete: SetNull)
  winner       TournamentParticipant? @relation("MatchWinner", fields: [winnerId], references: [id], onDelete: SetNull)

  @@index([tournamentId])
  @@map("tournament_matches")
}
