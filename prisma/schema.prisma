// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BookingType {
  HOURLY
  EVENT
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum BookingStatus {
  HOLD
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  EXPIRED
}

enum BookingSource {
  WALK_IN
  PHONE
  INSTAGRAM
  REFERRAL
  ONLINE
}

// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model AppUser {
  id           String    @id @default(cuid())
  name         String
  phone        String    @unique
  email        String?   @unique
  passwordHash String?
  role         Role      @default(CUSTOMER)
  notes        String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  bookings     Booking[]
  feedback     Feedback[]

  @@index([phone])
  @@index([role])
  @@map("app_users")
}

model Game {
  id              String    @id @default(cuid())
  name            String
  tag             String    @unique
  description     String?
  basePrice       Decimal   @db.Decimal(10, 2)  // Rs per hour
  minTimeMinutes  Int       @default(30)
  maxTimeMinutes  Int       @default(120)
  deposit         Decimal?  @db.Decimal(10, 2)
  isActive        Boolean   @default(true)
  totalUnits      Int       @default(1)
  hasAccessories  Boolean   @default(false)
  defaultAccessories Int     @default(0)
  maxAccessories   Int       @default(0)
  accessoryPrice   Decimal   @default(0.00) @db.Decimal(10, 2)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  resourceUnits   ResourceUnit[]
  bookings        Booking[]

  @@index([tag])
  @@index([isActive])
  @@map("games")
}

model ResourceUnit {
  id        String    @id @default(cuid())
  gameId    String
  unitName  String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  game      Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  bookings  Booking[]

  @@index([gameId])
  @@map("resource_units")
}

model Booking {
  id             String        @id @default(cuid())
  userId         String?
  guestName      String?
  guestPhone     String?
  gameId         String
  resourceUnitId String?
  startDateTime  DateTime
  endDateTime    DateTime
  durationMinutes Int
  accessoriesCount Int         @default(0)
  bookingType    BookingType   @default(HOURLY)
  basePrice      Decimal       @db.Decimal(10, 2)
  discountPct    Decimal       @default(0) @db.Decimal(5, 2)
  discountAmount Decimal       @default(0) @db.Decimal(10, 2)
  couponId       String?
  couponDiscount Decimal       @default(0.00) @db.Decimal(10, 2)
  finalAmount    Decimal       @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(UNPAID)
  bookingStatus  BookingStatus @default(HOLD)
  source         BookingSource @default(WALK_IN)
  notes          String?
  holdExpiresAt  DateTime?
  createdById    String?
  negotiatedAmount Decimal?    @db.Decimal(10, 2)
  paymentMethod    String?
  cashAmount       Decimal?    @db.Decimal(10, 2)
  onlineAmount     Decimal?    @db.Decimal(10, 2)
  paymentId        String?
  snacksAmount     Decimal?    @default(0) @db.Decimal(10, 2)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  user           AppUser?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  game           Game          @relation(fields: [gameId], references: [id])
  resourceUnit   ResourceUnit? @relation(fields: [resourceUnitId], references: [id], onDelete: SetNull)
  coupon         Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)

  @@index([startDateTime])
  @@index([gameId])
  @@index([userId])
  @@index([bookingStatus])
  @@index([resourceUnitId])
  @@index([holdExpiresAt])
  @@index([couponId])
  @@map("bookings")
}

model DiscountRule {
  id              String   @id @default(cuid())
  minHoursInDay   Decimal  @db.Decimal(5, 2)
  discountPct     Decimal  @db.Decimal(5, 2)
  description     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("discount_rules")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorName  String?
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

model Feedback {
  id          String   @id @default(cuid())
  userId      String?
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        AppUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdAt])
  @@map("feedback")
}

// ─────────────────────────────────────────
// COUPONS
// ─────────────────────────────────────────

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id               String        @id @default(cuid())
  code             String        @unique
  discountType     DiscountType  @default(PERCENTAGE)
  discountValue    Decimal       @db.Decimal(10, 2)
  minBookingAmount Decimal       @default(0.00) @db.Decimal(10, 2)
  maxDiscountAmount Decimal?     @db.Decimal(10, 2)
  allowedRoles     Role[]        @default([ADMIN, STAFF, CUSTOMER])
  isActive         Boolean       @default(true)
  usedCount        Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  bookings         Booking[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}
